#!name=AI Via Tailscale
#!desc=所有AI应用走Tailscale隧道

[Rule]
# > IP检测网站规则
DOMAIN-SUFFIX,ping0.cc,PROXY

# > ChatGPT
DOMAIN-SUFFIX,chat.com,TAILSCALE
DOMAIN-SUFFIX,chatgpt.com,TAILSCALE
DOMAIN-SUFFIX,livekit.cloud,TAILSCALE
DOMAIN-SUFFIX,oaistatic.com,TAILSCALE
DOMAIN-SUFFIX,oaiusercontent.com,TAILSCALE
DOMAIN-SUFFIX,openai.com,TAILSCALE
DOMAIN-SUFFIX,sora.com,TAILSCALE
DOMAIN,api.statsig.com,TAILSCALE
DOMAIN,api-iam.intercom.io,TAILSCALE
DOMAIN,o33249.ingest.sentry.io,TAILSCALE
DOMAIN,openaiapi-site.azureedge.net,TAILSCALE
DOMAIN-KEYWORD,openaiapi,TAILSCALE
DOMAIN-KEYWORD,openaicom,TAILSCALE

# > Apple Intelligence
DOMAIN-WILDCARD,*mask*.apple-dns.net,TAILSCALE
DOMAIN-WILDCARD,*mask*.icloud.com,TAILSCALE
DOMAIN-WILDCARD,*siri*.apple.com,TAILSCALE
DOMAIN-SUFFIX,smoot.apple.com,TAILSCALE
DOMAIN,apple-relay.apple.com,TAILSCALE
